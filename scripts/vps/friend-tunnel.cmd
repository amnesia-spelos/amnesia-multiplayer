@echo off
rem Generated by up.ps1 -FriendHosts from scripts\vps\friend-tunnel.cmd and shipped next to tunnel_key.
rem Runs on the friend's PC (the Session Host) and reconnects until closed.
setlocal
cd /d "%~dp0"
title Multimnesia tunnel
set SSH=%SystemRoot%\System32\OpenSSH\ssh.exe
if not exist "%SSH%" (
    echo OpenSSH Client is missing. Install it under Settings ^> System ^> Optional features, then run this again.
    pause
    exit /b 1
)
rem Windows ssh refuses a private key that other accounts can read.
icacls tunnel_key /inheritance:r /grant:r "%USERNAME%:R" >nul || (
    echo Could not restrict the permissions of tunnel_key.
    pause
    exit /b 1
)

echo Keep this window open for the whole session; close it when you are done playing.
echo Then start Multimnesia, start the game, and type /host. Your friend joins with /join {{VPS_IP}}
echo.
echo No output below means the tunnel is up. You can /host again at any time without restarting it.
echo.
:connect
"%SSH%" -N -p {{SSH_PORT}} -i tunnel_key ^
    -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes ^
    -o UserKnownHostsFile=known_hosts -o StrictHostKeyChecking=accept-new ^
    -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 ^
    -o ExitOnForwardFailure=yes ^
    -R 0.0.0.0:{{RELAY_PORT}}:127.0.0.1:{{RELAY_PORT}} tunnel@{{VPS_IP}}
rem After a drop the VPS may hold the old forward for up to 45 seconds, so retries can fail at first.
echo Tunnel closed; reconnecting in 10 seconds. Close this window to stop.
timeout /t 10 /nobreak >nul
goto connect
