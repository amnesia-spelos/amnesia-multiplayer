void OnStart()
{
    InteractConnectPropWithMoveObject(
        "ValveGate",
        "valve_iron_rusty_1",
        "castle_portcullis_1",
        true,
        false,
        0
    );

    SetEntityConnectionStateChangeCallback("light_lever", "RoomLightLeverChanged");
    SetLightVisible("RoomLight", false);
    SetMultiSliderCallback("water_wheel_cog_panel_1", "RoomLightColorChanged");

    SetButtonSwitchedOn("test_button", false, false);
    SetLampLit("candlestick_tri_1", false, false);

    SetEntityConnectionStateChangeCallback(
        "test_button", "TestButtonChanged");

    ConnectEntities(
        "TestButtonCandle",
        "test_button",
        "candlestick_tri_1",
        false, 0, "TestButtonConnected");

    AddEntityCollideCallback("Player", "SpawnGruntArea", "SpawnGrunt", true, 1);
}

void SpawnGrunt(string &in asParent, string &in asChild, int alState)
{
    SetEntityActive("grunt", true);
    for (int i = 0; i < 5; i++)
    {
        AddEnemyPatrolNode("grunt", "PathNodeArea_6", 5.0f, "");
        AddEnemyPatrolNode("grunt", "PathNodeArea_13", 10.0f, "");
        AddEnemyPatrolNode("grunt", "PathNodeArea_2", 5.0f, "");
    }
}

void RoomLightColorChanged(string &in asEntity, int alState)
{
    // Change RGB color over 0.25 seconds, keeping the existing light radius.
    if(alState == 0)
        FadeLightTo("RoomLight", 0.7, 0.05, 0.05, 1.0, -1.0, 0.25);
    else if(alState == 1)
        FadeLightTo("RoomLight", 0.05, 0.7, 0.05, 1.0, -1.0, 0.25);
    else if(alState == 2)
        FadeLightTo("RoomLight", 0.05, 0.05, 0.7, 1.0, -1.0, 0.25);
}

void RoomLightLeverChanged(string &in asEntity, int alState)
{
    // Keep the current light setting while the lever moves between its limits.
    if(alState == 1)
        SetLightVisible("RoomLight", true);
    else if(alState == -1)
        SetLightVisible("RoomLight", false);
}

void TestButtonChanged(string &in asEntity, int alState)
{
    Print("TEST79: button state callback\n");

    if(alState == 1)
        SetButtonSwitchedOn(asEntity, false, true);
}

void TestButtonConnected(
    string &in asConnection,
    string &in asParent,
    string &in asChild,
    int alState)
{
    Print("TEST79: button connection callback\n");
}
