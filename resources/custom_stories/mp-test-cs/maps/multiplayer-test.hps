void OnStart()
{
    SetSanityDrainDisabled(true);
    SetInDarknessEffectsActive(false);

    InteractConnectPropWithMoveObject(
        "ValveGate",
        "valve_iron_rusty_1",
        "castle_portcullis_1",
        true,
        false,
        0
    );

    SetEntityConnectionStateChangeCallback("light_lever", "RoomLightLeverChanged");
    SetLightVisible("RoomLight", false);
    SetMultiSliderCallback("water_wheel_cog_panel_1", "RoomLightColorChanged");

    SetButtonSwitchedOn("test_button", false, false);
    SetLampLit("candlestick_tri_1", false, false);

    SetEntityConnectionStateChangeCallback(
        "test_button", "TestButtonChanged");

    ConnectEntities(
        "TestButtonCandle",
        "test_button",
        "candlestick_tri_1",
        false, 0, "TestButtonConnected");

    AddEntityCollideCallback("Player", "SpawnGruntArea", "SpawnGrunt", true, 1);

    // Enemy-triggered callbacks (#77). The Session Host's game simulates the Grunt and shares them, so each one
    // runs once in each game: the Grunt breaking mansion_1 on its patrol, walking into SpawnGruntArea, and
    // disabling itself at the end of its patrol, unseen.
    SetEntityCallbackFunc("mansion_1", "MansionDoorCallback");
    AddEntityCollideCallback("grunt", "SpawnGruntArea", "GruntEnteredSpawnArea", false, 1);
    SetEntityCallbackFunc("grunt", "GruntCallback");

    // The Brute encounter (#78). Interacting with cabinet_simple_1 spawns the Brute on the Grunt's patrol, reversed.
    // Whichever enemy spawns first, the other one's trigger goes away until the story starts fresh.
    SetEntityPlayerInteractCallback("cabinet_simple_1", "SpawnBrute", true);
    SetEntityCallbackFunc("brute", "BruteCallback");

    // Hallucinations (#83). Grabbing vase01_1 makes the Grunt a hallucination, which disappears within 3 m of
    // either player. Grabbing it again once the Grunt has spawned brings the Grunt back, still a hallucination.
    SetEntityPlayerInteractCallback("vase01_1", "MakeGruntHallucination", false);
}

void MakeGruntHallucination(string &in asEntity)
{
    SetEnemyIsHallucination("grunt", true);
    if(GetLocalVarInt("GruntSpawned") == 1) SetEntityActive("grunt", true);
    Print("TEST83: grunt is a hallucination\n");
}

void MansionDoorCallback(string &in asEntity, string &in asType)
{
    if(asType != "Break") return;
    Print("TEST77: mansion_1 broke\n");
    StartScreenShake(0.03f, 0.5f, 0.1f, 0.3f);
}

void GruntEnteredSpawnArea(string &in asParent, string &in asChild, int alState)
{
    Print("TEST77: grunt entered SpawnGruntArea\n");
}

void GruntCallback(string &in asEntity, string &in asType)
{
    if(asType == "OnAutoDisabled") Print("TEST77: grunt auto-disabled\n");
}

void BruteCallback(string &in asEntity, string &in asType)
{
    if(asType == "OnAutoDisabled") Print("TEST78: brute auto-disabled\n");
}

void SpawnGrunt(string &in asParent, string &in asChild, int alState)
{
    SetLocalVarInt("GruntSpawned", 1);
    SetEntityPlayerInteractCallback("cabinet_simple_1", "", true);
    SetEntityActive("grunt", true);
    for (int i = 0; i < 5; i++)
    {
        AddEnemyPatrolNode("grunt", "PathNodeArea_6", 5.0f, "");
        AddEnemyPatrolNode("grunt", "PathNodeArea_13", 10.0f, "");
        AddEnemyPatrolNode("grunt", "PathNodeArea_2", 5.0f, "");
    }
}

void SpawnBrute(string &in asEntity)
{
    SetLocalVarInt("BruteSpawned", 1);
    RemoveEntityCollideCallback("Player", "SpawnGruntArea");
    SetEntityActive("brute", true);
    for (int i = 0; i < 5; i++)
    {
        AddEnemyPatrolNode("brute", "PathNodeArea_2", 5.0f, "");
        AddEnemyPatrolNode("brute", "PathNodeArea_13", 10.0f, "");
        AddEnemyPatrolNode("brute", "PathNodeArea_6", 5.0f, "");
    }
}

void RoomLightColorChanged(string &in asEntity, int alState)
{
    // Change RGB color over 0.25 seconds, keeping the existing light radius.
    if(alState == 0)
        FadeLightTo("RoomLight", 0.7, 0.05, 0.05, 1.0, -1.0, 0.25);
    else if(alState == 1)
        FadeLightTo("RoomLight", 0.05, 0.7, 0.05, 1.0, -1.0, 0.25);
    else if(alState == 2)
        FadeLightTo("RoomLight", 0.05, 0.05, 0.7, 1.0, -1.0, 0.25);
}

void RoomLightLeverChanged(string &in asEntity, int alState)
{
    // Keep the current light setting while the lever moves between its limits.
    if(alState == 1)
    {
        // We hook into the existing lever, if the light is on, players heal.
        EnableHealing(true);
        SetLightVisible("RoomLight", true);
    }
    else if(alState == -1)
    {
        // if the light is off, players no longer heal in case we need to test death.
        EnableHealing(false);
        SetLightVisible("RoomLight", false);
        // From then on a death runs a checkpoint callback (Shared Deaths, #75). Until the light is first
        // turned off, the map has only the automatic _auto checkpoint, without one. Registering the same
        // name again changes nothing, so turning the light off again keeps the count.
        CheckPoint("light_off", "PlayerStartArea_1", "LightOffDeath", "", "");
    }
}

// Shows the count this game's callback received: the room light comes on red for 0, green for 1, and
// blue for 2. The checkpoint reset the enemies, so each one spawned before comes back for the next death.
// The death at count 1 replaces this checkpoint, so its next death receives 1 again, as vanilla. The death
// at count 3 changes maps.
void LightOffDeath(string &in asName, int alCount)
{
    SetLightVisible("RoomLight", true);
    if(GetLocalVarInt("GruntSpawned") == 1) SetEntityActive("grunt", true);
    if(GetLocalVarInt("BruteSpawned") == 1) SetEntityActive("brute", true);
    RoomLightColorChanged(asName, alCount);
    if(asName == "light_off" && alCount == 1)
        CheckPoint("light_off_again", "PlayerStartArea_1", "LightOffDeath", "", "");
    if(alCount >= 3)
        ChangeMap("alt-map.map", "PlayerStartArea_1", "", "");
}

void TestButtonChanged(string &in asEntity, int alState)
{
    Print("TEST79: button state callback\n");

    if(alState == 1)
        SetButtonSwitchedOn(asEntity, false, true);
}

void TestButtonConnected(
    string &in asConnection,
    string &in asParent,
    string &in asChild,
    int alState)
{
    Print("TEST79: button connection callback\n");
}

// A helper system while testing shared enemy behavior
// in order to prevent players from dying to the enemy
// we set their health to 100% every second, that way
// we can test enemy damaging the player over and over.
void EnableHealing(bool shouldBeHealing)
{
    SetLocalVarInt("PreventDeath", shouldBeHealing ? 1 : 0);
    // Flipping the lever again within a second must not start a second loop.
    RemoveTimer("HealTimer");
    if (shouldBeHealing) HealTimer("HealTimer");
}

void HealTimer(string &in asTimer)
{
    if (GetLocalVarInt("PreventDeath") != 1) { return; }

    SetPlayerHealth(100.0f);
    AddTimer("HealTimer", 1.0f, "HealTimer");
}
